{
    "configurations": [
        {
            "name": "myOS",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__i386__"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu99",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x86",
            "compilerArgs": [
                "-m32",
                "-ffreestanding",
                "-fno-stack-protector",
                "-fno-pie",
                "-fno-pic"
            ]
        }
    ],
    "version": 4
}